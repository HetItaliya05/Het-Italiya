{
  "compilerOptions": {
    "target": "ES2020",

    "useDefineForClassFields": true,

    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],

    "module": "ESNext",

    "skipLibCheck": true,

    "types": ["node"],

    // =====================================================
    // VITE / BUNDLER
    // =====================================================

    "moduleResolution": "bundler",

    "allowImportingTsExtensions": true,

    "resolveJsonModule": true,

    "isolatedModules": true,

    "noEmit": true,

    "jsx": "react-jsx",

    // =====================================================
    // PATH ALIAS
    // =====================================================

    // "baseUrl": ".",

  

    // =====================================================
    // STRICT MODE
    // =====================================================

    "strict": true,

    // OPTIONAL
    // disable if too many TS errors
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "noFallthroughCasesInSwitch": true
  },

  "include": [
    "src",
    "vite.config.ts"
  ]
}